---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowUpRight, ArrowLeft, Search } from "@lucide/astro";
import { site } from "@/config/site";
import {
  categoryKeys,
  estimateReadingMinutes,
  formatDate,
  getCategoryUrl,
  getPostUrl,
  getPublishedPosts,
  getTagUrl,
} from "@/lib/content";
import "@/styles/archive.css";
const posts = await getPublishedPosts();
---

<BaseLayout
  title="Writing"
  description="정진용의 연구 노트. LLM과 Federated Learning, 논문과 실험, 구현 과정의 기록입니다."
  bodyClass="archive-page"
>
  <div class="archive-shell">
    <header class="archive-header">
      <a class="archive-back" href="/"
        ><ArrowLeft size={14} /> Back to profile</a
      >
      <p class="archive-eyebrow">Notes from the work</p>
      <div class="archive-title-row">
        <h1>Writing</h1>
        <span class="archive-edition"
          >Research &amp; development<br />An ongoing collection</span
        >
      </div>
      <p class="archive-intro">
        읽은 논문, 직접 해본 실험, 만들면서 배운 것들.<br />연구와 개발의 과정을
        차근히 기록합니다.
      </p>
    </header>
    <nav class="archive-categories" aria-label="글 카테고리">
      <span class="archive-category-current" aria-current="page"
        >All notes <span>{posts.length}</span></span
      >
      {
        categoryKeys.map((category) => (
          <a href={getCategoryUrl(category)}>
            {site.categories[category].label}
            <ArrowUpRight size={12} />
          </a>
        ))
      }
    </nav>
    <div class="archive-toolbar">
      <p
        id="blog-search-summary"
        class="archive-summary"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {posts.length}개의 글
      </p>
      <label class="archive-search" for="blog-search">
        <Search size={16} aria-hidden="true" /><span class="sr-only"
          >제목, 설명, 태그로 글 검색</span
        >
        <input
          id="blog-search"
          type="search"
          placeholder="Search notes…"
          autocomplete="off"
          aria-controls="blog-post-list"
        />
      </label>
    </div>
    <section
      id="blog-post-list"
      class="archive-list"
      aria-label="연구와 개발 기록"
    >
      {
        posts.map((post, index) => (
          <article
            class="archive-entry"
            data-post-card
            data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")} ${post.data.category} ${site.categories[post.data.category].label}`.toLocaleLowerCase()}
          >
            <div class="archive-entry-meta">
              <span class="archive-entry-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <span>{estimateReadingMinutes(post.body)} min read</span>
              {post.data.draft && (
                <span class="archive-draft">Draft · 미리보기</span>
              )}
            </div>
            <div class="archive-entry-body">
              <a
                class="archive-entry-category"
                href={getCategoryUrl(post.data.category)}
              >
                {site.categories[post.data.category].label}
              </a>
              <h2>
                <a href={getPostUrl(post)}>
                  {post.data.title}
                  <ArrowUpRight
                    class="archive-title-arrow"
                    size={23}
                    stroke-width={1.5}
                  />
                </a>
              </h2>
              <p>{post.data.description}</p>
              <ul class="archive-tags" aria-label="글 태그">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={getTagUrl(tag)}>#{tag}</a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>
    <div id="blog-empty" class="archive-empty" hidden={posts.length > 0}>
      <p>
        {
          posts.length
            ? "일치하는 글이 없습니다."
            : "아직 공개된 글이 없습니다."
        }
      </p>
      <span
        >{
          posts.length
            ? "다른 키워드로 검색하거나 검색어를 지워보세요."
            : "연구와 개발의 기록이 이곳에 쌓입니다."
        }</span
      >
    </div>
    <footer class="archive-note">
      <span>Ideas in progress, knowledge in practice.</span><a href="/projects/"
        >Explore the work <ArrowUpRight size={15} /></a
      >
    </footer>
  </div>
  <script>
    function mountBlogSearch() {
      const input = document.querySelector<HTMLInputElement>("#blog-search");
      if (!input || input.dataset.searchReady) return;
      input.dataset.searchReady = "true";
      const summary = document.querySelector<HTMLElement>(
        "#blog-search-summary",
      );
      const empty = document.querySelector<HTMLElement>("#blog-empty");
      const rows = [
        ...document.querySelectorAll<HTMLElement>("[data-post-card]"),
      ];
      const update = () => {
        const query = (input?.value ?? "").trim().toLocaleLowerCase();
        let visible = 0;
        for (const row of rows) {
          row.hidden = !!query && !(row.dataset.search ?? "").includes(query);
          if (!row.hidden) visible += 1;
        }
        if (summary)
          summary.textContent = query
            ? `“${input?.value.trim()}” 검색 결과 ${visible}개`
            : `${rows.length}개의 글`;
        if (empty) empty.hidden = visible > 0;
      };
      if (input)
        input.value =
          new URLSearchParams(window.location.search).get("q") ?? "";
      input?.addEventListener("input", update);
      update();
    }
    mountBlogSearch();
    document.addEventListener("astro:page-load", mountBlogSearch);
  </script>
</BaseLayout>
