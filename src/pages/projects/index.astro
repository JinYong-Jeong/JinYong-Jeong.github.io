---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowUpRight, ArrowLeft, Search } from "@lucide/astro";
import { formatDate, getAllProjects } from "@/lib/content";
import "@/styles/archive.css";
const projects = await getAllProjects();
const statusLabels = {
  active: "Active",
  paused: "Paused",
  archived: "Archived",
  idea: "Idea",
  fork: "Fork",
};
---

<BaseLayout
  title="Selected work"
  description="정진용의 프로젝트와 공개 작업. 연구 아이디어를 코드와 시스템으로 구현한 기록입니다."
  bodyClass="archive-page"
>
  <div class="archive-shell">
    <header class="archive-header">
      <a class="archive-back" href="/"
        ><ArrowLeft size={14} /> Back to profile</a
      >
      <p class="archive-eyebrow">From idea to implementation</p>
      <div class="archive-title-row">
        <h1>Selected work</h1>
        <span class="archive-edition"
          >Research &amp; engineering<br />A collection of practice</span
        >
      </div>
      <p class="archive-intro">
        아이디어를 코드로, 실험을 시스템으로.<br />직접 만들고 탐구해 온
        프로젝트를 모았습니다.
      </p>
    </header>
    <div class="archive-toolbar archive-toolbar-projects">
      <p
        id="project-search-summary"
        class="archive-summary"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {projects.length}개의 프로젝트
      </p>
      <label class="archive-search" for="project-search">
        <Search size={16} aria-hidden="true" /><span class="sr-only"
          >이름, 설명, 기술 스택으로 프로젝트 검색</span
        >
        <input
          id="project-search"
          type="search"
          placeholder="Search projects, stack…"
          autocomplete="off"
          aria-controls="project-list"
        />
      </label>
    </div>
    <section id="project-list" class="archive-list" aria-label="프로젝트 목록">
      {
        projects.map((project, index) => (
          <article
            id={project.id}
            class="archive-entry archive-project"
            data-project-row
            data-search={`${project.data.title} ${project.data.description} ${project.data.status} ${project.data.techStack.join(" ")}`.toLocaleLowerCase()}
          >
            <div class="archive-entry-meta">
              <span class="archive-entry-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="archive-status" data-status={project.data.status}>
                {statusLabels[project.data.status]}
              </span>
              <time datetime={project.data.date.toISOString()}>
                {project.data.source === "github" ? "Updated " : ""}
                {formatDate(project.data.date)}
              </time>
            </div>
            <div class="archive-entry-body">
              <>
                <h2>{project.data.title}</h2>
                <p>{project.data.description}</p>
              </>
              <ul class="archive-stack" aria-label="기술 스택">
                {project.data.techStack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
              <div class="archive-project-links">
                {project.data.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                    <ArrowUpRight size={15} />
                    <span class="sr-only"> (새 탭)</span>
                  </a>
                ))}
                {project.data.source === "github" &&
                  (project.data.stars ?? 0) > 0 && (
                    <span class="archive-project-stars">
                      {project.data.stars} GitHub stars
                    </span>
                  )}
              </div>
            </div>
          </article>
        ))
      }
    </section>
    <div id="project-empty" class="archive-empty" hidden={projects.length > 0}>
      <p>
        {
          projects.length
            ? "일치하는 프로젝트가 없습니다."
            : "등록된 프로젝트가 없습니다."
        }
      </p>
      <span
        >{
          projects.length
            ? "다른 기술 스택을 검색하거나 검색어를 지워보세요."
            : "새로운 작업이 이곳에 추가됩니다."
        }</span
      >
    </div>
    <footer class="archive-note">
      <span>Built, tested, and always learning.</span><a href="/blog/"
        >Read the notes <ArrowUpRight size={15} /></a
      >
    </footer>
  </div>
  <script>
    function mountProjectSearch() {
      const input = document.querySelector<HTMLInputElement>("#project-search");
      if (!input || input.dataset.searchReady) return;
      input.dataset.searchReady = "true";
      const summary = document.querySelector<HTMLElement>(
        "#project-search-summary",
      );
      const empty = document.querySelector<HTMLElement>("#project-empty");
      const rows = [
        ...document.querySelectorAll<HTMLElement>("[data-project-row]"),
      ];
      const update = () => {
        const query = (input?.value ?? "").trim().toLocaleLowerCase();
        let visible = 0;
        for (const row of rows) {
          row.hidden = !!query && !(row.dataset.search ?? "").includes(query);
          if (!row.hidden) visible += 1;
        }
        if (summary)
          summary.textContent = query
            ? `“${input?.value.trim()}” 검색 결과 ${visible}개`
            : `${rows.length}개의 프로젝트`;
        if (empty) empty.hidden = visible > 0;
      };
      if (input)
        input.value =
          new URLSearchParams(window.location.search).get("q") ?? "";
      input?.addEventListener("input", update);
      update();
    }
    mountProjectSearch();
    document.addEventListener("astro:page-load", mountProjectSearch);
  </script>
</BaseLayout>
