---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutBlock from "@/components/AboutBlock.astro";
import aboutSource from "../../content/about/page.json";
import { normalizeAboutPage } from "@/lib/about-components";

const page = normalizeAboutPage(aboutSource);
const mainBlocks = page.blocks.filter((block) => block.area === "main");
const profileBlocks = mainBlocks.filter((block) => block.type === "profile");
const contentBlocks = mainBlocks.filter((block) => block.type !== "profile");
const sidebarBlocks = page.blocks.filter((block) => block.area === "sidebar");
---

<BaseLayout title={page.title} description={page.description}>
  <div class="container-page page-wrap">
    <div class="page-layout">
      <section class="page-main-panel">
        {profileBlocks.map((block) => <AboutBlock block={block} />)}
        {contentBlocks.length > 0 && (
          <div class="about-content-grid">
            {contentBlocks.map((block) => <AboutBlock block={block} />)}
          </div>
        )}
      </section>

      {sidebarBlocks.length > 0 && (
        <aside class="home-sidebar-stack lg:sticky lg:top-24 lg:self-start">
          {sidebarBlocks.map((block) => <AboutBlock block={block} />)}
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
