---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RecordDesk from "@/components/RecordDesk.astro";
import { cv } from "@/config/cv";
import { getPublishedPosts, getPostUrl, formatDate } from "@/lib/content";
import {
  ArrowDown,
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Copy,
  MessageCircle,
} from "@lucide/astro";
import "@/styles/cv.css";

const posts = (await getPublishedPosts()).slice(0, 2);
const sections = [
  { id: "experience", label: "경력과 학력" },
  { id: "work", label: "프로젝트" },
  { id: "research", label: "논문" },
  { id: "awards", label: "수상" },
  { id: "writing", label: "글" },
  { id: "contact", label: "연락처" },
];
const projectOrder = ["aing", "fedops", "portfolio"];
const work = [...cv.work].sort(
  (a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id),
);
---

<BaseLayout bodyClass="cv-page" mainClass="cv-main">
  <div class="cv-shell">
    <section
      id="overview"
      class="cv-hero"
      aria-labelledby="cv-name"
      data-cv-section
    >
      <div class="cv-hero-copy">
        <p class="cv-eyebrow hero-kicker">
          <span aria-hidden="true"></span> A PERSONAL CV
        </p>
        <h1 id="cv-name">Jinyong<br /><em>Jeong</em></h1>
        <p class="cv-byline">
          <strong>{cv.koreanName}</strong><span aria-hidden="true">/</span
          >컴퓨터공학도 · 학부연구생
        </p>
        <p class="cv-intro">{cv.intro}</p>
        <div class="cv-hero-actions">
          <button type="button" class="cv-button" data-open-record-desk hidden
            ><BookOpen size={16} /> 기록집 펼치기</button
          >
          <a class="cv-read" href="#curriculum"
            >이력 바로 읽기 <ArrowDown size={15} /></a
          >
        </div>
        <div class="cv-social-links" aria-label="외부 프로필">
          <a href="https://github.com/JinYong-Jeong"
            >GitHub <ArrowUpRight size={12} /></a
          >
          <a href="https://www.linkedin.com/in/jinyongjeong/"
            >LinkedIn <ArrowUpRight size={12} /></a
          >
        </div>
      </div>
      <RecordDesk />
    </section>
    <div id="curriculum" class="cv-docket">
      <BookOpen size={23} stroke-width={1.45} aria-hidden="true" />
      <h2>Curriculum vitae</h2>
    </div>
    <div class="cv-document">
      <aside class="cv-index">
        <nav aria-label="CV 목차">
          {
            sections.map((s) => (
              <a href={`#${s.id}`} data-section-link={s.id}>
                {s.label}
              </a>
            ))
          }
        </nav>
      </aside>
      <div class="cv-sections">
        <section
          id="experience"
          class="cv-section"
          data-cv-section
          aria-labelledby="experience-title"
        >
          <header class="cv-section-heading">
            <div>
              <span class="cv-eyebrow">경력과 학력</span><h2
                id="experience-title"
              >
                Experience <em>& education</em>
              </h2>
            </div>
          </header>
          <div class="cv-timeline">
            {
              cv.experience.map((item, i) => (
                <details
                  class="cv-experience"
                  id={i === 0 ? "ccl" : "aing-experience"}
                >
                  <summary>
                    <>
                      <span class="cv-date">{item.period}</span>
                      <span class="cv-experience-main">
                        <>
                          <strong>{item.organization}</strong>
                          <span>{item.role}</span>
                          <small>{item.summary}</small>
                        </>
                      </span>
                      <span class="cv-expand" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="cv-experience-details">
                    {item.details.map((detail) => (
                      <p>{detail}</p>
                    ))}
                    <a class="cv-text-link" href={item.href}>
                      활동 기록 <ArrowUpRight size={13} />
                    </a>
                  </div>
                </details>
              ))
            }
          </div>
          <div id="education" class="cv-education">
            <span class="cv-date">{cv.education.period}</span><div>
              <h3>{cv.education.school}</h3><p>{cv.education.degree}</p>
            </div>
          </div>
        </section>
        <section
          id="work"
          class="cv-section"
          data-cv-section
          aria-labelledby="work-title"
        >
          <header class="cv-section-heading">
            <div>
              <span class="cv-eyebrow">프로젝트</span><h2 id="work-title">
                Selected <em>work</em>
              </h2>
            </div><a class="cv-text-link" href="/projects/"
              >전체 보기 <ArrowRight size={14} /></a
            >
          </header>
          <div class="work-files" data-files>
            <div class="file-tabs" aria-label="프로젝트 선택" hidden>
              {
                work.map((item) => (
                  <button
                    id={`tab-${item.id}`}
                    type="button"
                    data-file={item.id}
                  >
                    {item.title}
                  </button>
                ))
              }
            </div>
            {
              work.map((item) => (
                <article class="file-sheet" id={item.id} data-file-page>
                  <div class="file-top">
                    <>
                      <span>{item.categoryLabel}</span>
                      <span>{item.tags.join(" · ")}</span>
                    </>
                  </div>
                  <>
                    <h3>{item.title}</h3>
                    <p class="file-subtitle">{item.subtitle}</p>
                    <p>{item.description}</p>
                  </>
                  <div class="file-actions">
                    <>
                      <a href={item.href}>
                        {item.linkLabel} <ArrowUpRight size={14} />
                      </a>
                      <button
                        type="button"
                        data-ask-record={
                          item.id === "aing" ? "aing-resnet" : item.id
                        }
                        data-question={`${item.title}에서 어떤 작업을 했나요?`}
                      >
                        이 작업에 대해 묻기 <MessageCircle size={14} />
                      </button>
                    </>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
        <section
          id="research"
          class="cv-section"
          data-cv-section
          aria-labelledby="research-title"
        >
          <header class="cv-section-heading">
            <div>
              <span class="cv-eyebrow">논문</span><h2 id="research-title">
                Publications
              </h2>
            </div>
          </header>
          <div class="cv-publications">
            {
              cv.publications.map((paper) => (
                <article class="cv-paper" id={paper.id}>
                  <span class="cv-paper-year">
                    {paper.year}
                    <small>{paper.type}</small>
                  </span>
                  <div>
                    <div class="cv-paper-meta">
                      <span>{paper.role}</span>
                      {paper.award && (
                        <span class="cv-award-tag">{paper.award}</span>
                      )}
                    </div>
                    <>
                      <h3>{paper.title}</h3>
                      <p class="cv-paper-korean">{paper.korean}</p>
                      <p class="cv-paper-venue">{paper.venue}</p>
                    </>
                    <div class="cv-paper-bottom">
                      <>
                        <span class="cv-paper-status">{paper.status}</span>
                        <a class="cv-text-link" href={paper.href}>
                          {paper.linkLabel}
                          <ArrowUpRight size={13} />
                        </a>
                      </>
                    </div>
                    <details class="cv-abstract">
                      <>
                        <summary>
                          연구 요약 <span aria-hidden="true">+</span>
                        </summary>
                        <p>{paper.description}</p>
                      </>
                    </details>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
        <section
          id="awards"
          class="cv-section"
          data-cv-section
          aria-labelledby="awards-title"
        >
          <header class="cv-section-heading">
            <div>
              <span class="cv-eyebrow">수상</span><h2 id="awards-title">
                Honors <em>& awards</em>
              </h2>
            </div>
          </header>
          <div class="cv-award-list">
            {
              cv.awards.map((award) => (
                <article>
                  <>
                    <span class="cv-date">{award.date}</span>
                    <div>
                      <>
                        <h3>{award.title}</h3>
                        <p>{award.organization}</p>
                        <small>{award.detail}</small>
                      </>
                    </div>
                  </>
                </article>
              ))
            }
          </div>
        </section>
        <section
          id="writing"
          class="cv-section"
          data-cv-section
          aria-labelledby="writing-title"
        >
          <header class="cv-section-heading">
            <div>
              <span class="cv-eyebrow">글</span><h2 id="writing-title">
                Field <em>notes</em>
              </h2>
            </div><a class="cv-text-link" href="/blog/"
              >모든 글 <ArrowRight size={14} /></a
            >
          </header>
          <div class="cv-notes">
            {
              posts.map((post) => (
                <a href={getPostUrl(post)}>
                  <>
                    <span class="cv-date">{formatDate(post.data.date)}</span>
                    <div>
                      <>
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                      </>
                    </div>
                    <ArrowUpRight size={18} />
                  </>
                </a>
              ))
            }
          </div>
        </section>
        <section
          id="contact"
          class="cv-section cv-contact"
          data-cv-section
          aria-labelledby="contact-title"
        >
          <span class="cv-eyebrow">연락처</span><h2 id="contact-title">
            Get in <em>touch</em>
          </h2>
          <div class="cv-contact-actions">
            <a href={`mailto:${cv.email}`}
              >{cv.email}<ArrowUpRight size={20} /></a
            ><button
              type="button"
              data-copy-email={cv.email}
              aria-label="이메일 주소 복사"
              hidden><Copy size={16} /></button
            >
          </div>
          <span class="cv-copy-status" aria-live="polite" data-copy-status
          ></span>
          <div class="cv-contact-bottom">
            <a href="https://www.linkedin.com/in/jinyongjeong/">LinkedIn ↗</a
            ><a href="#overview">맨 위로 ↑</a>
          </div>
        </section>
      </div>
    </div>
  </div>
  <script>
    import "@/scripts/cv";
  </script>
</BaseLayout>
