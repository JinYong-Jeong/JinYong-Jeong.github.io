---
import { ArrowLeft } from "@lucide/astro";

interface Props {
  kicker: string;
  title: string;
  description: string;
}

const { kicker, title, description } = Astro.props;
---

<header class="editorial-heading">
  <a class="editorial-back" href="/">
    <ArrowLeft size={14} aria-hidden="true" /> Back to profile
  </a>
  <p class="editorial-kicker">{kicker}</p>
  <h1>{title}</h1>
  <p class="editorial-description">{description}</p>
</header>

<style>
  .editorial-heading {
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-paper);
  }
  .editorial-back {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    margin-bottom: 2.75rem;
  }
  .editorial-back:hover {
    color: var(--color-primary);
  }
  .editorial-kicker {
    margin: 0 0 1.15rem;
    color: var(--color-secondary);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.12;
    overflow-wrap: anywhere;
  }

  .editorial-description {
    max-width: 58ch;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.96rem;
    line-height: 1.95;
  }
</style>
