---
import type { Project } from "@/lib/content";
import { CodeXml } from "@lucide/astro";

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const key = project.id.toLowerCase();
---

<div class:list={["project-visual overflow-hidden", compact ? "rounded-[0.9rem] border border-[var(--color-border)]" : "rounded-[0.9rem]"]}>
  {
    key.includes("flower") && (
      <svg viewBox="0 0 420 190" class="h-full w-full" role="img" aria-label="Federated learning project visual">
        <defs>
          <marker id="project-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 Z" fill="var(--color-bronze)" />
          </marker>
        </defs>
        <rect x="252" y="52" width="118" height="86" rx="12" fill="var(--color-primary)" />
        <text x="311" y="88" text-anchor="middle" fill="var(--color-surface)" font-size="17" font-weight="700">Flower</text>
        <text x="311" y="112" text-anchor="middle" fill="var(--color-surface)" font-size="17" font-weight="700">Server</text>
        {[32, 80, 128].map((y, index) => (
          <>
            <rect x="44" y={y} width="98" height="32" rx="7" fill="var(--color-surface)" stroke="var(--color-border)" />
            <text x="93" y={y + 20} text-anchor="middle" fill="var(--color-ink)" font-size="12">
              Client {index + 1}
            </text>
            <path
              d={`M148 ${y + 16} C184 ${y + 16}, 204 92, 248 94`}
              stroke="var(--color-bronze)"
              stroke-width="1.4"
              stroke-dasharray="4 4"
              fill="none"
              marker-end="url(#project-arrow)"
            />
          </>
        ))}
      </svg>
    )
  }
  {
    key.includes("evaluation") && (
      <svg viewBox="0 0 420 190" class="h-full w-full" role="img" aria-label="Evaluation dashboard visual">
        <line x1="50" y1="146" x2="374" y2="146" stroke="var(--color-border)" />
        <line x1="50" y1="34" x2="50" y2="146" stroke="var(--color-border)" />
        {[84, 132, 180, 228].map((x, index) => (
          <rect
            x={x}
            y={130 - index * 18}
            width="18"
            height={index * 18 + 16}
            rx="4"
            fill={["color-mix(in srgb, var(--color-primary) 25%, var(--color-surface))", "color-mix(in srgb, var(--color-primary) 45%, var(--color-surface))", "color-mix(in srgb, var(--color-primary) 65%, var(--color-surface))", "var(--color-bronze)"][index]}
          />
        ))}
        <path
          d="M78 122 C126 84, 178 96, 230 68 S330 58, 356 42"
          fill="none"
          stroke="var(--color-primary)"
          stroke-width="3"
        />
        <circle cx="356" cy="42" r="5" fill="var(--color-primary)" />
      </svg>
    )
  }
  {
    key.includes("logger") && (
      <div class="grid h-full place-items-center p-6">
        <div class="w-24 rounded-[1rem] border border-[var(--color-primary)] bg-[var(--color-ink)] p-3 shadow-[0_18px_40px_color-mix(in_srgb,var(--color-ink)_24%,transparent)]">
          <div class="mb-3 flex gap-1.5">
            <span class="size-2 rounded-full bg-[var(--color-subtle)]"></span>
            <span class="size-2 rounded-full bg-[var(--color-subtle)]"></span>
            <span class="size-2 rounded-full bg-[var(--color-subtle)]"></span>
          </div>
          <div class="space-y-2">
            <div class="h-1.5 rounded-full bg-[var(--color-primary)]"></div>
            <div class="h-1.5 w-3/4 rounded-full bg-[var(--color-bronze)]"></div>
            <div class="h-1.5 w-4/5 rounded-full bg-[var(--color-muted)]"></div>
            <div class="mt-4 grid grid-cols-3 gap-1.5">
              <div class="h-7 rounded-md bg-[var(--color-primary)]"></div>
              <div class="h-7 rounded-md bg-[var(--color-primary)]"></div>
              <div class="h-7 rounded-md bg-[var(--color-primary)]"></div>
            </div>
          </div>
        </div>
      </div>
    )
  }
  {
    project.data.source === "github" &&
      !key.includes("flower") &&
      !key.includes("evaluation") &&
      !key.includes("logger") && (
        <div class="flex h-full flex-col justify-between p-5">
          <CodeXml size={25} stroke-width={1.7} class="text-[var(--color-accent)]" />
          <div>
            <p class="line-clamp-2 text-lg font-bold leading-snug text-[var(--color-text)]">
              {project.data.repository}
            </p>
            <p class="mt-2 text-xs text-[var(--color-muted)]">
              {project.data.techStack[0] ?? "GitHub Repository"}
            </p>
          </div>
        </div>
      )
  }
</div>
