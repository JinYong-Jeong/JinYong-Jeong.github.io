---
import { Image, getImage } from "astro:assets";
import { cv } from "@/config/cv";
import dragon from "../../engineering/design/logo2.png";
import study from "../../engineering/design/bg.png";
import "@/styles/record-desk.css";

const wood = await getImage({
  src: study,
  width: 1200,
  format: "webp",
  quality: 78,
});
const fedops = cv.work.find((work) => work.id === "fedops")!;
const studyMaterials = cv.work.find((work) => work.id === "aing")!;
const chapters = [
  {
    id: "education",
    topic: "education",
    label: "Education",
    category: "학력",
    heading: cv.education.school,
    subtitle: cv.education.degree,
    description:
      "언어 모델이 어떤 도구를 선택하고, 그 결과로 어떻게 답을 만드는지 공부합니다.",
    evidence: "재학 기간",
    detail: cv.education.period,
    href: "#education",
    link: "학력 기록 보기",
    question: "어디에서 무엇을 전공하고 있나요?",
  },
  {
    id: "projects",
    topic: fedops.id,
    label: "Projects",
    category: "프로젝트",
    heading: fedops.title,
    subtitle: "모델을 공유하고 에이전트에 연결하는 일",
    description:
      "팀에서 FedOps의 모델 저장소와 Agent Studio를 연결하는 개발에 참여했습니다. 공유한 모델을 에이전트의 도구로 쓰는 과정입니다.",
    evidence: "Interactive CV",
    detail: "이 기록집과 방문자의 브라우저에서 답하는 챗봇도 직접 만들었습니다.",
    href: "#fedops",
    link: "프로젝트 기록 보기",
    question: "FedOps에서 어떤 개발에 참여했나요?",
  },
  {
    id: "research",
    topic: "health-agent",
    label: "Research",
    category: "연구",
    heading: "Agents & LLMs",
    subtitle: "Cognitive Computing Lab · 학부연구생",
    description:
      "건강 예측 모델을 AI 에이전트의 도구로 연결했습니다. 웨어러블 원본 데이터는 기기에 두고, 예측 결과를 개인의 맥락에 맞게 설명하는 연구입니다.",
    evidence: "온디바이스 LLM",
    detail: "동결된 LLM의 응답을 경량 판단 모델로 유도하는 방법도 연구했습니다.",
    href: "#research",
    link: `논문 ${cv.publications.length}편과 저자 역할 보기`,
    question: "개인건강데이터 연구에서 에이전트는 예측 모델을 어떻게 활용하나요?",
  },
  {
    id: "activities",
    topic: "aing-resnet",
    label: "Activities",
    category: "대외활동",
    heading: "A.ing",
    subtitle: "가천대학교 인공지능 학술동아리",
    description:
      "동료들과 ResNet 주니어 스터디 교재를 만들었습니다. 논문 속 잔차 연결을 PyTorch로 구현하고 CIFAR-10으로 실험하는 과정입니다.",
    evidence: "학회 발표",
    detail: "한국데이터사이언스학회 추계종합학술대회에서 System 1 연구를 구두 발표했습니다.",
    href: studyMaterials.href,
    link: "ResNet 교육자료 보기",
    question: "ResNet 스터디에서 무엇을 직접 구현하나요?",
  },
];
---

<section
  class="record-desk"
  data-record-desk
  data-open="false"
  tabindex="-1"
  aria-label="정진용의 기록집"
  style={`--rd-study: url('${wood.src}')`}
>
  <div class="rd-scene">
    <div class="rd-room-light" aria-hidden="true"></div>
    <div class="rd-table" aria-hidden="true"></div>
    <div class="rd-window-shadow" aria-hidden="true"></div>
    <div class="rd-pencil" aria-hidden="true"><i></i></div>
    <span class="rd-desk-caption" aria-hidden="true">THE PERSONAL ARCHIVE</span>
    <button
      type="button"
      class="rd-close"
      data-book-close
      hidden
      aria-label="기록집 덮기"><span aria-hidden="true">×</span> 덮기</button
    >

    <div class="rd-book">
      <div class="rd-cast-shadow" aria-hidden="true"></div>
      <div class="rd-back-board" aria-hidden="true"></div>
      <div class="rd-page-block" aria-hidden="true"></div>
      <div class="rd-ribbon" aria-hidden="true"></div>

      <div
        class="rd-spread"
        id="personal-record-pages"
        aria-hidden="true"
        inert
      >
        <div
          class="rd-bookmarks"
          role="tablist"
          aria-label="어떤 기록을 펼칠까요?"
        >
          {
            chapters.map((chapter, index) => (
              <button
                type="button"
                role="tab"
                id={`rd-tab-${chapter.id}`}
                aria-controls={`rd-page-${chapter.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                lang="en"
                data-book-tab={index}
              >
                {chapter.label}
              </button>
            ))
          }
        </div>
        <div class="rd-paper">
          <div class="rd-paper-grain" aria-hidden="true"></div>
          {
            chapters.map((chapter, index) => (
              <article
                class="rd-page"
                id={`rd-page-${chapter.id}`}
                role="tabpanel"
                aria-labelledby={`rd-tab-${chapter.id}`}
                data-book-page={index}
                hidden={index !== 0}
              >
                <p class="rd-page-kicker">{chapter.category}</p>
                <h3 tabindex="-1" lang="en">{chapter.heading}</h3>
                <p class="rd-page-title">{chapter.subtitle}</p>
                <span class="rd-small-rule" aria-hidden="true" />
                <p class="rd-page-description">{chapter.description}</p>
                <div class="rd-evidence">
                  <strong>{chapter.evidence}</strong>
                  <p>{chapter.detail}</p>
                </div>
                <a
                  class="rd-evidence-link"
                  href={chapter.href}
                  target={chapter.href.startsWith("https") ? "_blank" : undefined}
                  rel={
                    chapter.href.startsWith("https")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {chapter.link}
                  <span aria-hidden="true">↗</span>
                </a>
                <button
                  type="button"
                  class="rd-question"
                  data-book-question={chapter.question}
                  data-book-topic={chapter.topic}
                >
                  이 챕터에 대해 묻기 <span aria-hidden="true">↗</span>
                </button>
              </article>
            ))
          }
          <nav class="rd-page-nav" aria-label="기록집 페이지">
            <button type="button" data-book-prev aria-label="이전 기록"
              ><span aria-hidden="true">←</span></button
            >
            <span class="rd-page-count" aria-hidden="true"
              ><span data-book-number>01</span><i>/</i>{String(chapters.length).padStart(2, "0")}</span
            >
            <button type="button" data-book-next aria-label="다음 기록"
              ><span aria-hidden="true">→</span></button
            >
          </nav>
          <span class="rd-binding" aria-hidden="true"></span>
        </div>
        <div class="rd-turn-sheet" aria-hidden="true"><span>J / J</span></div>
      </div>

      <div class="rd-cover">
        <div class="rd-cover-front">
          <div class="rd-cover-grain" aria-hidden="true"></div>
          <span class="rd-cover-edition">A PERSONAL RECORD · VOL 01</span>
          <span class="rd-seal" aria-hidden="true"
            ><Image
              src={dragon}
              alt=""
              width={220}
              height={220}
              format="webp"
              loading="eager"
            /></span
          >
          <span class="rd-cover-name">Jinyong<br />Jeong</span>
          <span class="rd-cover-subtitle">배우고, 만들고, 함께한 기록</span>
          <span class="rd-cover-line" aria-hidden="true"></span>
          <span class="rd-cover-year">정진용 · PERSONAL ARCHIVE</span>
          <button
            type="button"
            class="rd-open"
            data-book-open
            aria-expanded="false"
            aria-controls="personal-record-pages"
            hidden
            ><span>나의 기록 펼치기</span><span aria-hidden="true">↗</span
            ></button
          >
          <noscript
            ><a class="rd-nojs" href="#experience">학력과 활동 읽기 ↗</a
            ></noscript
          >
        </div>
        <div class="rd-cover-inside" aria-hidden="true">
          <span class="rd-inside-eyebrow">THIS BOOK BELONGS TO</span>
          <span class="rd-inside-name">Jinyong<br />Jeong</span>
          <span class="rd-inside-rule"></span>
          <p>하나의 직함보다,<br />여러 개의 기록으로</p>
          <ol>{chapters.map((chapter) => <li>{chapter.category}</li>)}</ol>
          <Image
            src={dragon}
            alt=""
            width={120}
            height={120}
            format="webp"
            loading="lazy"
          />
          <span class="rd-inside-colophon"
            >GACHON UNIVERSITY<br />LEARNING / MAKING / SHARING</span
          >
        </div>
      </div>
      <div class="rd-spine" aria-hidden="true"><span>JINYONG JEONG</span></div>
    </div>
    <p class="rd-scene-note">
      <span data-book-hint>책을 펼쳐 네 가지 기록을 살펴보세요.</span>
    </p>
  </div>
  <p
    class="rd-live"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-book-status
  >
  </p>
</section>

<script>
  import "@/scripts/record-desk";
</script>
